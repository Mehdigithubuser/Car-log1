<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F7F9FC">

    <TextView android:layout_width="match_parent" android:layout_height="64dp"
        android:gravity="center_vertical" android:paddingStart="20dp"
        android:text="CarLog" android:textSize="26sp" android:textStyle="bold"
        android:textColor="#192432" android:background="#FFFFFF"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <ScrollView android:id="@+id/homeView" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:id="@+id/vehicleTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="My Vehicle" android:textSize="24sp" android:textStyle="bold" android:textColor="#192432"/>
                <TextView android:id="@+id/vehicleSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Tap Vehicle profile to add your car" android:textSize="14sp" android:textColor="#667380"
                    android:layout_marginTop="4dp"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Overview" android:textSize="19sp" android:textStyle="bold"
                    android:textColor="#192432" android:layout_marginTop="24dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/totalValue" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1"
                        android:gravity="center" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="#192432" android:background="#FFFFFF"/>
                    <TextView android:id="@+id/fuelValue" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1"
                        android:gravity="center" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#206BC4" android:background="#FFFFFF"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/serviceValue" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1"
                        android:gravity="center" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#1A968C" android:background="#FFFFFF"/>
                    <TextView android:id="@+id/expenseValue" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1"
                        android:gravity="center" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#7C5CC4" android:background="#FFFFFF"/>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Quick actions" android:textSize="19sp" android:textStyle="bold"
                    android:textColor="#192432" android:layout_marginTop="22dp"/>

                <Button android:id="@+id/quickFuel" android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="Fuel" android:textAllCaps="false"/>
                <Button android:id="@+id/quickService" android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="Service" android:textAllCaps="false"/>
                <Button android:id="@+id/quickExpense" android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="Expense" android:textAllCaps="false"/>
                <Button android:id="@+id/quickReminder" android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="Reminder" android:textAllCaps="false"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Next reminder" android:textSize="19sp" android:textStyle="bold"
                    android:textColor="#192432" android:layout_marginTop="22dp"/>
                <TextView android:id="@+id/upcomingText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="No upcoming reminders" android:textSize="15sp" android:textColor="#206BC4"
                    android:padding="14dp" android:background="#FFFFFF"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Recent activity" android:textSize="19sp" android:textStyle="bold"
                    android:textColor="#192432" android:layout_marginTop="22dp"/>
                <TextView android:id="@+id/recentList" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="No records yet" android:textSize="14sp" android:textColor="#667380"
                    android:padding="14dp" android:background="#FFFFFF"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/maintenanceView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <Button android:id="@+id/addServicePage" android:layout_width="match_parent" android:layout_height="52dp" android:text="Add service" android:textAllCaps="false"/>
                <LinearLayout android:id="@+id/maintenanceList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/reminderView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <Button android:id="@+id/addReminderPage" android:layout_width="match_parent" android:layout_height="52dp" android:text="Add reminder" android:textAllCaps="false"/>
                <LinearLayout android:id="@+id/reminderList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/moreView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <Button android:id="@+id/vehicleProfilePage" android:layout_width="match_parent" android:layout_height="52dp" android:text="Vehicle profile" android:textAllCaps="false"/>
                <Button android:id="@+id/reportsPage" android:layout_width="match_parent" android:layout_height="52dp" android:text="Reports" android:textAllCaps="false"/>
                <Button android:id="@+id/backupPage" android:layout_width="match_parent" android:layout_height="52dp" android:text="Backup / Restore" android:textAllCaps="false"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:background="#FFFFFF">
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Home" android:textColor="#206BC4"/>
        <TextView android:id="@+id/navMaintenance" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Maintenance" android:textColor="#667380"/>
        <TextView android:id="@+id/navReminders" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Reminders" android:textColor="#667380"/>
        <TextView android:id="@+id/navMore" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="More" android:textColor="#667380"/>
    </LinearLayout>
</LinearLayout>